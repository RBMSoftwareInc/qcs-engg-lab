# QCS Studio Authentication
# Option A: Single user from env (legacy)
VITE_STUDIO_EMAIL=your-email@example.com
VITE_STUDIO_PASSWORD=your-secure-password

# Option B: Multi-user from config/studio-users.json (recommended)
# Create first admin at /studio/settings/users when no config exists.
# Set a salt in production (required for secure hashing):
# STUDIO_PASSWORD_SALT=your-random-secret-salt-at-least-32-chars

# SEO & Analytics (optional – leave unset to disable)
# Canonical and Open Graph URLs; used in sitemap and meta tags
VITE_PUBLIC_SITE_URL=https://yourdomain.com
# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
VITE_GTM_ID=
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# AI (Studio editor: suggest, meta description, transform). Optional.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Or: AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL overrides default (e.g. gpt-4o-mini, claude-3-5-haiku-20241022)
# AI_MODEL=
